# Supabase (obrigatório)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key

# Sessão (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=troque-por-uma-string-aleatoria-de-32-chars-ou-mais

# Porta (Hostinger define automaticamente via variável PORT)
# PORT=3000

# URL pública do sistema — o link do email de "Esqueci minha senha" volta pra cá
# (precisa estar também em Supabase → Authentication → URL Configuration → Redirect URLs)
APP_URL=https://seu-dominio.com.br
